# ── Hostinger MySQL Database ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_courier
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_courier_db

# ── Server Port ──
# On Hostinger Node.js, Hostinger assigns a port or listens on process.env.PORT
PORT=5000

# ── JWT Secret ──
JWT_SECRET=your_jwt_super_secret_production_key_here
JWT_EXPIRES_IN=7d

# ── Encryption Key (32 characters for AES-256 API Key storage) ──
ENCRYPTION_KEY=courier-portal-default-enc-key-32!

# ── Remote DB / WP Sync (Optional) ──
WP_SYNC_ENABLED=false
WP_SYNC_URL=
WP_SYNC_KEY=
REMEMOTE_DB_ENABLED=false
